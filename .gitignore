# ==========================================
# NLSI TELEMETRY
# Git Ignore
# ==========================================

# ==========================================
# BUILD / CMAKE
# ==========================================

/build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile
compile_commands.json

# CMake generated files
*.cmake.user
*.ninja
.ninja_deps
.ninja_log

# ==========================================
# C++ / MSVC GENERATED FILES
# ==========================================

*.obj
*.o
*.pdb
*.ilk
*.idb
*.ipdb
*.iobj
*.tlog
*.lastbuildstate
*.exp
*.pch
*.res

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# ==========================================
# PYTHON
# ==========================================

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# IDE / EDITORS
# ==========================================

.vscode/
.idea/

# ==========================================
# ENVIRONMENT / SECRETS
# ==========================================

.env
.env.local
.env.*.local

# Keep example environment files
!.env.example

# Credentials / secrets
/secrets/
**/secrets/

*.secret
*.secret.*
credentials.json
**/credentials.json
*-credentials.json
*_credentials.json

secrets.json
**/secrets.json

token.json
**/token.json

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# ==========================================
# LOGS
# ==========================================

*.log
/logs/
change-log/
build-output.log
build-test.log

# ==========================================
# RUNTIME / GENERATED DATA
# ==========================================

# Session/runtime output
/data/sessions/
/data/cache/
/data/runtime/

# Test output
/test/output/

# Keep directory placeholders
!/data/sessions/.gitkeep
!/test/output/.gitkeep

# JSONL/runtime telemetry
*.jsonl

# ==========================================
# TEMPORARY FILES
# ==========================================

*.tmp
*.temp
*.bak
*.swp
*.swo
*.old

# Inno Setup temporary files
*.iss.tmp
*.iss.bak
*.iss~

# ==========================================
# INSTALLER BUILD TEMPORARY FILES
# ==========================================

/installer/staging/
/installer/temp/
/installer/output/

# ==========================================
# GENERATED APPLICATION BINARIES
# ==========================================

# Ignore generated binaries inside normal build folders
/build/**/*.exe
/build/**/*.dll
/build/**/*.lib

# ==========================================
# SCS SDK / EXTERNAL SDK EXTRACTS
# ==========================================

/scs_sdk/
/scs_sdk_*/
/SCS_SDK*/

# ==========================================
# OS FILES
# ==========================================

.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
# LOCAL USER DATA
# ==========================================

/data/user/
/data/local/
/data/cache/

# ==========================================
# NLSI LOCAL CONFIGURATION
# ==========================================

/config/local/